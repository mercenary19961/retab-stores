APP_NAME="Retab Stores"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# Must be the real public URL in production: webhook, payment-return, email and
# sitemap URLs are all built from it, and it is the host every generated URL is
# pinned to (URL::forceRootUrl). No trailing slash.
APP_URL=http://localhost

# Set to false to keep the site OUT of Google while it stays publicly reachable
# (pre-launch, Moyasar's review, client walkthroughs). Every response then sends
# X-Robots-Tag: noindex. Defaults to true, so it must be opted out of
# explicitly. 🔴 Remove it / set true at launch or the live store stays hidden.
# SITE_INDEXABLE=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# 🔴 Set SESSION_SECURE_COOKIE=true in production. config/session.php reads this
# with no default, and Laravel treats a null as FALSE — it does NOT infer it
# from the request being https — so leaving it unset ships the session and
# XSRF cookies without the Secure flag. Leave it off locally (http://localhost).
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Back-office admin bootstrap (production). Set BOTH before the first deploy so
# they're baked into the cached config, then run once from the deploy console:
#   php artisan db:seed --class=AdminUserSeeder --force
# Left blank in local/dev — the seeder falls back to admin@retab.com.sa / password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# =============================================================================
# External integrations (payments, shipping, WhatsApp, bot gate, media).
# All blank in dev => each feature no-ops safely. Fill from the provider
# dashboards in the Railway env for staging/production. After setting any of
# these, verify them with:  php artisan integrations:check
# Webhook URLs below are built from APP_URL, so APP_URL must be the real site URL.
# =============================================================================

# --- Cloudflare Turnstile: bot gate on the three guest-facing forms that cost us
# something per submission (WhatsApp OTP send, Coming-Soon product request,
# Contact Us). Keys: dash.cloudflare.com -> Turnstile -> Add widget, and list
# BOTH retab.com.sa and www.retab.com.sa as allowed hostnames.
#   Both blank            => the gate no-ops entirely (the dev default).
#   ⚠️ SECRET set alone   => every guest submission is REJECTED. The widget only
#                            renders when the SITE key is present, so no token is
#                            ever produced and the verifier fails closed. Set the
#                            two together or neither.
# Read at runtime (a shared Inertia prop), so no rebuild is needed to change them.
# Cloudflare's published test keys, handy for verifying the wiring:
#   always passes: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
#   always blocks: site 2x00000000000000000000AB / secret 2x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Moyasar : cards (mada / Visa / Mastercard / Apple Pay / STC Pay)
# dashboard.moyasar.com -> Settings -> API keys (Secret) + Webhooks.
# Register the webhook:  {APP_URL}/webhooks/moyasar  (its signing secret below)
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
# MOYASAR_BASE_URL=https://api.moyasar.com/v1   # default (test + live share this URL)

# --- Tamara : installments / BNPL
# Merchant portal -> Integration/API. Start in SANDBOX, then switch to prod.
# Register the webhook:  {APP_URL}/webhooks/tamara
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=
# TAMARA_BASE_URL=https://api-sandbox.tamara.co   # sandbox; prod = https://api.tamara.co (the default)

# --- OTO / Tryoto : shipping (GCC only; filter out Aramex/DHL)
# tryoto.com dashboard -> generate a refresh token. ORIGIN_CITY = warehouse city.
# Register the webhook:  {APP_URL}/webhooks/oto
OTO_REFRESH_TOKEN=
OTO_WEBHOOK_SECRET=
OTO_ORIGIN_CITY=Riyadh
# OTO_BASE_URL=https://api.tryoto.com/rest/v2   # default

# --- WhatsApp : Meta Cloud API (order + marketing messages)
# Leave driver=log in dev (writes to the log). Set driver=cloud + the token/id
# from developers.facebook.com (WhatsApp product) to send live.
# Webhook: {APP_URL}/webhooks/whatsapp  (GET handshake uses WHATSAPP_VERIFY_TOKEN)
# WHATSAPP_DRIVER=log
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ADMIN_RECIPIENTS=          # comma-separated phone numbers alerted on new orders

# --- Resend : transactional email (staff order/return alerts; customer mail later)
# resend.com -> API Keys. A SEND-ONLY key is preferred: it can send but not read
# other endpoints (integrations:check understands that and still reports OK).
# Then resend.com -> Domains -> add retabstore.com and paste the DKIM/SPF records
# into Cloudflare DNS. ⚠️ Until that domain verifies, the ONLY from-address Resend
# accepts is onboarding@resend.dev — anything else fails with "domain is not verified".
# Prove a real send with:  php artisan mail:test <address>
#   (delivered@resend.dev is Resend's simulator — safe, never hits a real inbox)
# ⚠️ Mail is QUEUED, so a queue worker must be running (see CLAUDE.md -> Notifications).
RESEND_KEY=
# MAIL_MAILER=resend                    # production; dev deliberately stays on `log`
# MAIL_FROM_ADDRESS=no-reply@retabstore.com   # must be on a VERIFIED domain
# MAIL_FROM_NAME="Retab Stores"

# --- Media storage : Cloudflare R2 in production (dev uses the local public disk)
# Set MEDIA_DISK=r2 + the R2_* creds on Railway (see CLAUDE.md -> File Storage).
# MEDIA_DISK=public
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_URL=                             # public bucket / custom domain base URL
# R2 buckets are PRIVATE by default — enable the bucket's public r2.dev URL or attach
# a custom domain, then put that base URL in R2_URL or every image 404s.
# After the creds are set, upload the existing files once: php artisan media:push

# No VITE_* variables are needed. The scaffold's VITE_APP_NAME was removed with the
# brand-suffix title template in resources/js/app.tsx — page titles carry their own
# bilingual branding. Note for anything added here later: VITE_* is inlined at BUILD
# time, so setting one on a running container does nothing until the next build.
